NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://aura_user:change-me@localhost:5432/aura_fitness
JWT_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Aura Fitness <info@example.com>
BOOKING_NOTIFICATION_EMAIL=info@example.com

# Used only by `npm run admin:create`; never shipped to the browser.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
